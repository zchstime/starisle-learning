CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold: { value: 0.5 }
        motion: { value: [0, 0, 0, 0] }
        fall0: { value: [0, 0, 0, 0] }
        fall1: { value: [0, 0, 0, 0] }
        fall2: { value: [0, 0, 0, 0] }
        fall3: { value: [0, 0, 0, 0] }
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    uv0 = a_texCoord;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif
    color = a_color;

    return pos;
  }
}%

CCProgram sprite-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>
  in vec4 color;
  in vec2 uv0;
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  uniform Scenery {
    vec4 motion;
    vec4 fall0;
    vec4 fall1;
    vec4 fall2;
    vec4 fall3;
  };
  float fallMask(vec2 uv, vec4 area) {
    vec2 p=(uv-area.xy)/max(area.zw,vec2(0.0001));
    return smoothstep(0.0,0.16,p.x)*(1.0-smoothstep(0.84,1.0,p.x))
      *smoothstep(0.0,0.12,p.y)*(1.0-smoothstep(0.82,1.0,p.y));
  }
  vec4 frag () {
    vec2 uv=uv0;
    vec4 original=CCSampleWithAlphaSeparated(cc_spriteTexture,uv);
    float t=motion.x, strength=motion.y, night=motion.z;
    float water=max(max(fallMask(uv,fall0),fallMask(uv,fall1)),max(fallMask(uv,fall2),fallMask(uv,fall3)));
    // Cool pale water only: never warp the surrounding stone or foliage.
    water*=smoothstep(-0.04,0.06,original.b-original.r)*smoothstep(0.38,0.72,original.b);
    vec2 flow=vec2(sin(uv.y*170.0-t*4.0)*0.0011,
      sin(uv.y*95.0-t*3.5)*0.0045+sin(uv.x*340.0+t)*0.001);
    // Large cloud masses breathe; bright, low-saturation pixels gate the displacement.
    float pale=smoothstep(0.62,0.90,min(original.r,original.b));
    float cloud=smoothstep(0.59,0.91,uv.y)*pale;
    vec2 drift=vec2(sin(t*0.22+uv.y*9.0)*0.009,cos(t*0.28+uv.x*13.0)*0.004);
    float sea=motion.w*smoothstep(0.34,0.5,uv.y)*smoothstep(0.12,0.24,original.g-original.r)*smoothstep(0.55,0.8,original.b);
    vec2 ripple=vec2(sin(uv.y*130.0+t*1.6)*0.0014,cos(uv.x*105.0+t)*0.0009);
    float foliage=smoothstep(0.04,0.15,original.g-original.r)*(1.0-smoothstep(0.42,0.65,original.b))*(1.0-smoothstep(0.62,0.78,uv.y));
    vec2 breeze=vec2(sin(t*1.2+uv.y*18.0)*0.0007,cos(t+uv.x*20.0)*0.00035);
    vec2 displaced=clamp(uv+strength*(water*flow+cloud*drift+sea*ripple+foliage*breeze),vec2(0.001),vec2(0.999));
    vec4 o=CCSampleWithAlphaSeparated(cc_spriteTexture,displaced);
    float glint=pow(max(0.0,sin(uv.x*380.0+t*1.2)*sin(uv.y*240.0-t*1.4)),12.0);
    o.rgb+=vec3(0.10,0.16,0.16)*glint*sea*strength;
    float ribbon=pow(0.5+0.5*sin(uv.y*225.0-t*6.0+sin(uv.x*410.0)),5.0);
    o.rgb+=vec3(0.055,0.085,0.09)*ribbon*water*strength;
    // Broad sun shafts sweep slowly, with a soft falloff rather than hard stripes.
    float beam=pow(0.5+0.5*sin((uv.x+uv.y*0.32)*22.0+sin(t*0.18)*0.8),12.0);
    float sky=1.0-smoothstep(0.06,0.67,uv.y);
    o.rgb+=vec3(0.10,0.075,0.035)*beam*sky*(1.0-night)*strength;
    float aurora=exp(-pow((uv.y-(0.15+0.055*sin(uv.x*7.0+t*0.18)))*20.0,2.0));
    float curtain=0.35+0.65*pow(0.5+0.5*sin(uv.x*55.0+t*0.45),3.0);
    o.rgb+=vec3(0.035,0.15,0.12)*aurora*curtain*night*strength;
    o*=color;
    ALPHA_TEST(o);
    return o;
  }
}%

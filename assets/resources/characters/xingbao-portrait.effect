// The portrait atlas already contains the reviewed studio exposure.
// Output its display colors without applying the scene's ACES tone map again.
CCEffect %{
  techniques:
  - passes:
    - vert: portrait-vs:vert
      frag: portrait-fs:frag
      rasterizerState: { cullMode: none }
      properties:
        mainTexture: { value: white }
        mainColor: { value: [1, 1, 1, 1], linear: true, editor: { type: color } }
}%

CCProgram portrait-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <legacy/input>
  #include <legacy/local-batch>
  out vec2 v_uv;
  #if USE_VERTEX_COLOR
    in vec4 a_color;
    out vec4 v_color;
  #endif
  vec4 vert () {
    vec4 position;
    CCVertInput(position);
    mat4 matWorld;
    CCGetWorldMatrix(matWorld);
    v_uv = a_texCoord;
    #if USE_VERTEX_COLOR
      v_color = a_color;
    #endif
    return cc_matProj * (cc_matView * matWorld) * position;
  }
}%

CCProgram portrait-fs %{
  precision highp float;
  #include <common/color/gamma>
  in vec2 v_uv;
  uniform Constant { vec4 mainColor; };
  #if USE_TEXTURE
    uniform sampler2D mainTexture;
  #endif
  #if USE_VERTEX_COLOR
    in vec4 v_color;
  #endif
  vec4 frag () {
    vec4 color = mainColor;
    #if USE_TEXTURE
      vec4 texel = texture(mainTexture, v_uv);
      color *= vec4(SRGBToLinear(texel.rgb), texel.a);
    #endif
    #if USE_VERTEX_COLOR
      color *= vec4(SRGBToLinear(v_color.rgb), v_color.a);
    #endif
    return vec4(LinearToSRGB(color.rgb), color.a);
  }
}%
